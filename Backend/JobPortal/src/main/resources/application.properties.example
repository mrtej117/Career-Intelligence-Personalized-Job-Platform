# =============================================================================
# Career Intelligence Personalized Job Platform — Example Configuration
# Copy this file to application.properties or set the corresponding ENV variables
# =============================================================================

# --- Server Port ---
server.port=8080

# --- Active Spring Profile ---
# Options: 'postgres' (recommended for full Career Intelligence) or 'dev' (H2 in-memory)
spring.profiles.active=postgres

# --- Database Configuration (PostgreSQL with pgvector) ---
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:jobportal}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_postgres_password}
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# --- JWT Authentication ---
# Must be at least 256 bits (32 characters) for HS256
jwt.secret=${JWT_SECRET:CareerIntelligenceSuperSecretKey256BitsMinimumLengthForDevelopmentOnlyChangeInProd!}
jwt.expiration=86400000

# --- Cloudinary (Optional: Profile Pictures & Resumes) ---
# If left blank, the platform automatically runs in LOCAL storage fallback mode.
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
cloudinary.api-key=${CLOUDINARY_API_KEY:}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:}

# --- Email Notifications ---
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
app.email.from=noreply@jobportal.com
app.email.name=JobSphere

# --- Rate Limiting ---
auth.ratelimit.requests=100
auth.ratelimit.window-minutes=1

# --- Career Intelligence & Scheduler ---
career.intelligence.scheduler.enabled=true
career.intelligence.collection.interval=3600000
career.intelligence.collection.max-concurrent-companies=4
career.intelligence.collection.request-timeout-ms=10000
career.intelligence.collection.max-retries=3

# --- Local Ollama AI Settings ---
ollama.base-url=${OLLAMA_BASE_URL:http://localhost:11434}
ollama.model=${OLLAMA_MODEL:llama3.2}
ollama.embedding-model=${OLLAMA_EMBEDDING_MODEL:nomic-embed-text}

# --- Demo Data Seeder ---
app.seed.enabled=true
